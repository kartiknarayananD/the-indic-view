{{!< default}}

<section class="homepage-hero">
    <div class="hero-inner">
        <a href="{{@site.url}}" class="hero-logo-link">
            <img
                src="{{asset 'images/logo-with-name.png'}}"
                alt="{{@site.title}}"
                class="hero-logo"
                width="340"
                loading="eager"
            >
        </a>
        <p class="hero-tagline"><em>Rationalism. Stories. Perspective.</em></p>
        <div class="hero-cta">
            <a href="#post-feed" class="btn btn-primary">Read Latest</a>
            <a href="#/portal/signup" class="btn btn-outline" data-portal="signup">Subscribe Free</a>
        </div>
    </div>
</section>

{{#if @site.cover_image}}
{{/if}}

<div class="homepage-content" id="post-feed">

    {{#get "posts" filter="featured:true" limit="1"}}
        {{#foreach posts}}
        <section class="featured-post-section">
            <div class="featured-post-inner">
                {{#if feature_image}}
                <a href="{{url}}" class="featured-post-image-link">
                    <div class="featured-post-image-wrap">
                        <img
                            class="featured-post-image"
                            src="{{img_url feature_image size='l'}}"
                            srcset="{{img_url feature_image size='m'}} 600w, {{img_url feature_image size='l'}} 1000w, {{img_url feature_image size='xl'}} 2000w"
                            sizes="(max-width: 900px) 100vw, 55vw"
                            alt="{{title}}"
                            loading="eager"
                        >
                    </div>
                </a>
                {{/if}}
                <div class="featured-post-content">
                    <div class="featured-eyebrow">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="#EF6C00" aria-hidden="true">
                            <polygon points="7,1 8.8,5.2 13.5,5.6 10,8.7 11.1,13.4 7,10.9 2.9,13.4 4,8.7 0.5,5.6 5.2,5.2"/>
                        </svg>
                        <span class="featured-label">Featured Blog</span>
                    </div>
                    {{#if primary_tag}}
                    <a href="{{primary_tag.url}}" class="post-card-tag tag-{{primary_tag.slug}}">{{primary_tag.name}}</a>
                    {{/if}}
                    <h2 class="featured-post-title">
                        <a href="{{url}}">{{title}}</a>
                    </h2>
                    {{#if custom_excerpt}}
                    <p class="featured-post-excerpt">{{custom_excerpt}}</p>
                    {{else if excerpt}}
                    <p class="featured-post-excerpt">{{excerpt words="40"}}</p>
                    {{/if}}
                    <a href="{{url}}" class="featured-read-link">Read blog &rarr;</a>
                    <div class="featured-post-meta">
                        {{#if primary_author.profile_image}}
                        <img
                            src="{{img_url primary_author.profile_image size='xs'}}"
                            alt="{{primary_author.name}}"
                            class="featured-author-avatar"
                            width="32"
                            height="32"
                            loading="lazy"
                        >
                        {{/if}}
                        <span class="featured-author-name">{{primary_author.name}}</span>
                        <span class="post-card-sep" aria-hidden="true">·</span>
                        <time datetime="{{date format='YYYY-MM-DD'}}">{{date format="D MMM YYYY"}}</time>
                        <span class="post-card-sep" aria-hidden="true">·</span>
                        <span>{{reading_time}}</span>
                    </div>
                </div>
            </div>
        </section>
        {{/foreach}}
    {{/get}}

    <section class="post-feed-section">
        <div class="post-feed-inner">
            <h2 class="section-heading">Latest Blogs</h2>
            <div class="post-feed">
                {{#foreach posts}}
                    {{> post-card}}
                {{/foreach}}
            </div>
            {{pagination}}
        </div>
    </section>

</div>
