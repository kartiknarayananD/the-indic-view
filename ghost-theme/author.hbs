{{!< default}}

<section class="tag-header">
    <div class="tag-header-inner">
        {{#author}}
        <div class="tag-eyebrow">
            <span class="tag-eyebrow-label">Author</span>
        </div>
        {{#if profile_image}}
        <img
            src="{{img_url profile_image size='s'}}"
            alt="{{name}}"
            class="author-header-avatar"
            width="80"
            height="80"
            loading="eager"
        >
        {{/if}}
        <h1 class="tag-title">{{name}}</h1>
        {{#if bio}}
        <p class="tag-description">{{bio}}</p>
        {{/if}}
        <p class="tag-post-count">{{plural ../pagination.total empty='No essays yet' singular='% essay' plural='% essays'}}</p>
        {{/author}}
    </div>
</section>

<div class="post-feed-section">
    <div class="post-feed-inner">
        <div class="post-feed">
            {{#foreach posts}}
                {{> post-card}}
            {{/foreach}}
        </div>
        {{pagination}}
    </div>
</div>
