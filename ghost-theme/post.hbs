{{!< default}}

<div class="reading-progress-bar" id="readingProgress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>

{{#post}}
<article class="post-full{{#unless feature_image}} no-feature-image{{/unless}}">

    <header class="post-header">
        <div class="post-header-inner">
            {{#if primary_tag}}
            <div class="post-tags">
                <a href="{{primary_tag.url}}" class="post-card-tag tag-{{primary_tag.slug}}">{{primary_tag.name}}</a>
            </div>
            {{/if}}
            <h1 class="post-title">{{title}}</h1>
            {{#if custom_excerpt}}
            <p class="post-excerpt">{{custom_excerpt}}</p>
            {{/if}}
            <div class="post-meta">
                {{#if primary_author}}
                <div class="post-author-info">
                    {{#if primary_author.profile_image}}
                    <a href="{{primary_author.url}}">
                        <img
                            class="post-author-avatar"
                            src="{{img_url primary_author.profile_image size='xs'}}"
                            alt="{{primary_author.name}}"
                            width="40"
                            height="40"
                            loading="lazy"
                        >
                    </a>
                    {{/if}}
                    <div class="post-author-details">
                        <a href="{{primary_author.url}}" class="post-author-name">{{primary_author.name}}</a>
                        <div class="post-meta-sub">
                            <time datetime="{{date format='YYYY-MM-DD'}}">{{date format="D MMMM YYYY"}}</time>
                            <span class="post-card-sep" aria-hidden="true">·</span>
                            <span>{{reading_time}}</span>
                        </div>
                    </div>
                </div>
                {{/if}}
                <div class="post-share post-share-top">
                    <button class="share-btn" onclick="window.sharePost('{{url absolute='true'}}', '{{title}}')" aria-label="Share this post">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="13" cy="3" r="1.5"/>
                            <circle cx="3" cy="8" r="1.5"/>
                            <circle cx="13" cy="13" r="1.5"/>
                            <line x1="4.5" y1="7" x2="11.5" y2="4"/>
                            <line x1="4.5" y1="9" x2="11.5" y2="12"/>
                        </svg>
                        Share
                    </button>
                </div>
            </div>
        </div>
    </header>

    {{#if feature_image}}
    <figure class="post-feature-image">
        <img
            src="{{img_url feature_image size='xl'}}"
            srcset="{{img_url feature_image size='m'}} 600w, {{img_url feature_image size='l'}} 1000w, {{img_url feature_image size='xl'}} 2000w"
            sizes="(max-width: 1200px) 100vw, 1200px"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            loading="eager"
        >
        {{#if feature_image_caption}}
        <figcaption class="post-feature-image-caption">{{feature_image_caption}}</figcaption>
        {{/if}}
    </figure>
    {{/if}}

    <div class="post-body-wrapper">
        <aside class="post-share-sidebar" aria-label="Share article">
            <div class="share-sidebar-inner">
                <span class="share-sidebar-label">Share</span>
                <a
                    href="https://twitter.com/intent/tweet?url={{encode (url absolute='true')}}&text={{encode title}}"
                    class="share-sidebar-btn share-twitter"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Share on Twitter"
                >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.736l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                    </svg>
                </a>
                <a
                    href="https://www.linkedin.com/shareArticle?mini=true&url={{encode (url absolute='true')}}&title={{encode title}}"
                    class="share-sidebar-btn share-linkedin"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Share on LinkedIn"
                >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                </a>
                <a
                    href="https://www.facebook.com/sharer/sharer.php?u={{encode (url absolute='true')}}"
                    class="share-sidebar-btn share-facebook"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Share on Facebook"
                >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                </a>
                <a
                    href="https://wa.me/?text={{encode title}}%20{{encode (url absolute='true')}}"
                    class="share-sidebar-btn share-whatsapp"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Share on WhatsApp"
                >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                    </svg>
                </a>
                <a
                    href="https://reddit.com/submit?url={{encode (url absolute='true')}}&title={{encode title}}"
                    class="share-sidebar-btn share-reddit"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Share on Reddit"
                >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/>
                    </svg>
                </a>
                <button
                    class="share-sidebar-btn share-copy"
                    onclick="window.copyPostLink('{{url absolute='true'}}')"
                    aria-label="Copy link"
                >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
                        <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/>
                    </svg>
                </button>
            </div>
        </aside>

        <section class="post-content gh-content">
            {{content}}
        </section>
    </div>

    <footer class="post-footer">
        {{#if tags}}
        <div class="post-footer-tags">
            <span class="post-footer-tags-label">Filed under</span>
            {{#foreach tags}}
                <a href="{{url}}" class="post-card-tag tag-{{slug}}">{{name}}</a>
            {{/foreach}}
        </div>
        {{/if}}
    </footer>

    {{!-- Single action ribbon: reactions | share | discussion toggle --}}
    <div class="post-action-bar" id="postActionBar" data-post-slug="{{slug}}" data-member="{{#if @member}}{{@member.uuid}}{{/if}}">
        <div class="action-bar-group">
            <button class="action-bar-btn reaction-like" id="reactionLike" aria-label="Love this essay" aria-pressed="false">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                <span class="action-bar-label">Loved it</span>
                <span class="action-bar-count" id="likeCount">0</span>
            </button>
            <button class="action-bar-btn reaction-dislike" id="reactionDislike" aria-label="Not for me" aria-pressed="false">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 15v4a3 3 0 003 3l4-9V2H5.72a2 2 0 00-2 1.7l-1.38 9a2 2 0 002 2.3H10z"/><path d="M17 2h2.67A2.31 2.31 0 0122 4v7a2.31 2.31 0 01-2.33 2H17"/></svg>
                <span class="action-bar-label">Not for me</span>
                <span class="action-bar-count" id="dislikeCount">0</span>
            </button>
        </div>
        <div class="action-bar-sep"></div>
        <div class="action-bar-group action-bar-share-group">
            <a class="action-bar-btn share-twitter" href="https://twitter.com/intent/tweet?url={{encode (url absolute='true')}}&text={{encode title}}" target="_blank" rel="noopener noreferrer" aria-label="Share on X / Twitter">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.736l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a class="action-bar-btn share-linkedin" href="https://www.linkedin.com/shareArticle?mini=true&url={{encode (url absolute='true')}}&title={{encode title}}" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a class="action-bar-btn share-facebook" href="https://www.facebook.com/sharer/sharer.php?u={{encode (url absolute='true')}}" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a class="action-bar-btn share-whatsapp" href="https://wa.me/?text={{encode title}}%20{{encode (url absolute='true')}}" target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
            <a class="action-bar-btn share-reddit" href="https://reddit.com/submit?url={{encode (url absolute='true')}}&title={{encode title}}" target="_blank" rel="noopener noreferrer" aria-label="Share on Reddit">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>
            </a>
            <button class="action-bar-btn share-copy" onclick="window.copyPostLink('{{url absolute='true'}}')" aria-label="Copy link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
                <span class="action-bar-label">Copy</span>
            </button>
        </div>
        {{#if @site.comments_enabled}}
        <div class="action-bar-sep"></div>
        <div class="action-bar-group">
            <button class="action-bar-btn action-bar-comments-btn" id="commentsToggleBtn" aria-expanded="false" aria-controls="commentsPanel">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                <span>Discussion</span>
            </button>
        </div>
        {{/if}}
    </div>

    {{!-- Comments panel: collapsed until Discussion button is clicked --}}
    {{#if @site.comments_enabled}}
    <div class="post-comments" id="commentsPanel">
        <div class="post-comments-inner">
            {{comments colorScheme='dark'}}
            <script>
            (function(){
                var m = document.cookie.match(/(?:^|;\s*)tiv-theme=([^;]*)/);
                var s = m ? decodeURIComponent(m[1]) : null;
                var isLight = s === 'light' || (!s && window.matchMedia && !window.matchMedia('(prefers-color-scheme: dark)').matches);
                if (isLight) {
                    var gc = document.querySelector('script[data-ghost-comments]');
                    if (gc) gc.setAttribute('data-color-scheme', 'light');
                }
            })();
            </script>
        </div>
    </div>
    {{/if}}

    {{#get "posts" filter="id:-{{id}}" limit="8"}}
    {{#if posts}}
    <section class="related-essays"
        data-current-tags="{{#foreach tags}}{{slug}}{{#unless @last}},{{/unless}}{{/foreach}}"
        data-current-title="{{title}}"
        data-current-excerpt="{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words='40'}}{{/if}}"
        data-current-rt="{{reading_time}}">
        <div class="related-essays-inner">
            <div class="related-essays-header">
                <span class="related-essays-eyebrow">Continue Reading</span>
                <h3 class="related-essays-heading">You might also enjoy</h3>
            </div>
            <div class="related-essays-grid" id="relatedEssaysGrid">
                {{#foreach posts}}
                <a href="{{url}}" class="related-essay-card"
                    data-tags="{{#foreach tags}}{{slug}}{{#unless @last}},{{/unless}}{{/foreach}}"
                    data-title="{{title}}"
                    data-excerpt="{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words='40'}}{{/if}}"
                    data-rt="{{reading_time}}">
                    <div class="related-essay-image{{#unless feature_image}} related-essay-image--none{{/unless}}">
                        {{#if feature_image}}
                        <img
                            src="{{img_url feature_image size='m'}}"
                            alt="{{title}}"
                            loading="lazy"
                            width="400"
                            height="240"
                        >
                        {{/if}}
                    </div>
                    <div class="related-essay-content">
                        {{#if primary_tag}}
                        <span class="related-essay-tag">{{primary_tag.name}}</span>
                        {{/if}}
                        <h4 class="related-essay-title">{{title}}</h4>
                        {{#if custom_excerpt}}
                        <p class="related-essay-excerpt">{{custom_excerpt}}</p>
                        {{/if}}
                        <div class="related-essay-meta">
                            <span class="related-essay-time">{{reading_time}}</span>
                            {{#if primary_author}}
                            <span class="related-essay-author">{{primary_author.name}}</span>
                            {{/if}}
                        </div>
                    </div>
                </a>
                {{/foreach}}
            </div>
        </div>
    </section>
    {{/if}}
    {{/get}}

