<header class="site-header" id="siteHeader">
    <div class="tricolor-strip"></div>
    <div class="header-inner">
        <div class="header-left">
            <a href="{{@site.url}}" class="site-logo-link" aria-label="{{@site.title}} home">
                <span class="nav-logo-wrap">
                    <img
                        src="{{asset 'images/logo-icon.png'}}"
                        alt="{{@site.title}} icon"
                        class="nav-logo-icon"
                    >
                </span>
                <span class="site-title-group">
                    <span class="site-title-main">The Indic View</span>
                    <span class="site-title-sub">by Kartik Narayanan</span>
                </span>
            </a>
        </div>

        <nav class="site-nav" aria-label="Main navigation">
            <ul class="nav-list">
                <li class="nav-item">
                    <a href="{{@site.url}}" class="nav-link js-nav-home">Home</a>
                </li>
                {{!-- Categories are pulled live: a tag only appears here once it
                     has at least one published post, so new sections (e.g. Politics)
                     show up automatically and the bar stays on one row. --}}
                {{#get "tags" filter="slug:[rationalism,unsung-heroes,indian-stories,relationships,politics-and-ideologies]" limit="10"}}
                    {{#foreach tags}}
                    <li class="nav-item">
                        <a href="{{url}}" class="nav-link js-tag-nav" data-tag-slug="{{slug}}">{{name}}</a>
                    </li>
                    {{/foreach}}
                {{/get}}
            </ul>
        </nav>

        <div class="header-right">
            {{#if @member}}
            <a href="#/portal/account" class="btn btn-outline btn-sm nav-account-btn" data-portal="account" aria-label="Your account">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span class="nav-account-label">{{#if @member.name}}{{@member.name}}{{else}}Account{{/if}}</span>
            </a>
            {{else}}
            <a href="#/portal/signup" class="btn btn-primary btn-sm nav-subscribe-btn" data-portal="signup">Subscribe</a>
            {{/if}}
            <div class="header-icons">
                <button class="search-btn" id="searchToggleBtn" aria-label="Search">
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6"/>
                        <path d="M13 13L17.5 17.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                </button>
                <button class="theme-toggle-btn" aria-label="Switch to dark mode">
                    <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                    <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="5"/>
                        <line x1="12" y1="1" x2="12" y2="3"/>
                        <line x1="12" y1="21" x2="12" y2="23"/>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                        <line x1="1" y1="12" x2="3" y2="12"/>
                        <line x1="21" y1="12" x2="23" y2="12"/>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                    </svg>
                </button>
                <a href="https://www.instagram.com/theindicviewblog" class="nav-ig-btn" target="_blank" rel="noopener noreferrer" aria-label="{{@site.title}} on Instagram">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                        <circle cx="12" cy="12" r="4"/>
                        <circle cx="17.5" cy="6.5" r=".9" fill="currentColor" stroke="none"/>
                    </svg>
                </a>
                <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu" aria-expanded="false">
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                </button>
            </div>
        </div>
    </div>

</header>
<div class="header-spacer"></div>
