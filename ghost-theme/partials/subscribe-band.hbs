{{#unless @member}}
<section class="subscribe-band">
    <div class="subscribe-band-inner">
        <div class="subscribe-band-logo">
            {{> logo-mark}}
        </div>
        <div class="subscribe-band-content">
            <h2 class="subscribe-band-heading">Ideas worth thinking about</h2>
            <p class="subscribe-band-sub">New blogs on rationalism, history, and forgotten India, free to your inbox.</p>
            <a href="#/portal/signup" class="btn btn-primary" data-portal="signup">Subscribe, it's free</a>
        </div>
    </div>
</section>
{{/unless}}
