<!DOCTYPE html>
<html lang="{{@site.locale}}" class="no-js">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    <script>
    (function(){
        var m=document.cookie.match(/(?:^|; )tiv-theme=([^;]*)/);
        if(m){document.documentElement.classList.add(decodeURIComponent(m[1]));}
    })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;1,8..60,300;1,8..60,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=DM+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="{{asset 'css/main.css'}}">
    {{ghost_head}}
</head>
<body class="{{body_class}} is-loading">

    {{> nav}}

    <main id="site-main" class="site-main">
        {{{body}}}
    </main>

    {{> subscribe-band}}
    {{> footer}}

    <nav class="mobile-menu" id="mobileMenu" aria-label="Mobile navigation" aria-hidden="true">
        <div class="mobile-menu-header">
            <span class="mobile-menu-title">Menu</span>
            <button class="mobile-menu-close" id="mobileMenuClose" aria-label="Close menu">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <line x1="2" y1="2" x2="16" y2="16"/>
                    <line x1="16" y1="2" x2="2" y2="16"/>
                </svg>
            </button>
        </div>
        <ul class="mobile-nav-list">
            <li><a href="{{@site.url}}" class="mobile-nav-link js-nav-home">Home</a></li>
            {{#get "tags" filter="slug:[rationalism,unsung-heroes,indian-stories,relationships,politics-and-ideologies]" limit="10"}}
                {{#foreach tags}}
                <li>
                    <a href="{{url}}" class="mobile-nav-link js-tag-nav" data-tag-slug="{{slug}}">{{name}}</a>
                </li>
                {{/foreach}}
            {{/get}}
        </ul>
        <div class="mobile-menu-footer">
            {{#if @member}}
            <a href="#/portal/account" class="btn btn-outline mobile-subscribe-btn" data-portal="account">{{#if @member.name}}{{@member.name}}{{else}}Your account{{/if}}</a>
            {{else}}
            <a href="#/portal/signup" class="btn btn-primary mobile-subscribe-btn" data-portal="signup">Subscribe, it&#x27;s free</a>
            {{/if}}
        </div>
    </nav>
    <div class="mobile-menu-overlay" id="mobileOverlay"></div>

    {{> search}}

    {{!-- Scroll-triggered subscribe nudge (post pages only, non-members) --}}
    {{#unless @member}}
    <div class="tiv-scroll-nudge" id="tivScrollNudge" aria-live="polite" aria-atomic="true">
        <div class="tiv-scroll-nudge-inner">
            <div class="tiv-scroll-nudge-text">
                <strong class="tiv-scroll-nudge-title">Enjoyed reading?</strong>
                <span class="tiv-scroll-nudge-sub">Subscribe to read new content as it drops.</span>
            </div>
            <a href="#/portal/signup" class="btn btn-primary tiv-scroll-nudge-btn" data-portal="signup">Subscribe</a>
            <button class="tiv-scroll-nudge-close" id="tivScrollNudgeClose" aria-label="Dismiss">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <line x1="2" y1="2" x2="12" y2="12"/><line x1="12" y1="2" x2="2" y2="12"/>
                </svg>
            </button>
        </div>
    </div>
    {{/unless}}

    {{!-- Post-signup share nudge — shown when Ghost fires ghost:member-signup --}}
    <div class="tiv-share-nudge" id="tivShareNudge" aria-hidden="true" role="dialog" aria-modal="true">
        <div class="tiv-share-nudge-panel">
            <button class="tiv-share-nudge-close" id="tivShareNudgeClose" aria-label="Close">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <line x1="2" y1="2" x2="14" y2="14"/><line x1="14" y1="2" x2="2" y2="14"/>
                </svg>
            </button>
            <div class="tiv-share-nudge-icon">🎉</div>
            <h3 class="tiv-share-nudge-heading">You're in. Welcome.</h3>
            <p class="tiv-share-nudge-body">Know someone who'd enjoy thoughtful writing on rationalism, history, and forgotten India? Share The Indic View with them.</p>
            <div class="tiv-share-nudge-actions">
                <button class="tiv-share-nudge-btn tiv-share-nudge-twitter" id="tivShareNudgeTwitter">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.736l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    Share on X
                </button>
                <button class="tiv-share-nudge-btn tiv-share-nudge-whatsapp" id="tivShareNudgeWhatsapp">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    WhatsApp
                </button>
                <button class="tiv-share-nudge-btn tiv-share-nudge-copy" id="tivShareNudgeCopy">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
                    Copy link
                </button>
            </div>
            <button class="tiv-share-nudge-skip" id="tivShareNudgeClose">Maybe later</button>
        </div>
    </div>

    {{!--
      Shared reaction counts backend (Supabase).
      Fill in your project URL and the anon/public key below to enable shared,
      persistent Like / Not-for-me counts. The anon key is safe to expose publicly
      — the database is locked down with RLS and only allows ±1 via the `react`
      function (see supabase-setup.sql). Leave blank to fall back to per-browser
      cookie counts. You can also set this via Ghost Settings → Code injection.
    --}}
