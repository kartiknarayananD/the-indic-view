{{!< default}}

{{!--
  About page template.
  Ghost applies this automatically to the page with slug "about".
  The hero pulls the site's primary author (name, photo, bio, social links).
  The editable body below renders whatever you write in the Ghost editor —
  put your passion, your story, and why you started the blog there.
--}}

{{#page}}
<article class="about-page">

    <header class="about-hero">
        <div class="about-hero-inner">
            <span class="about-eyebrow">About</span>
            <h1 class="about-title">{{#if title}}{{title}}{{else}}{{@site.title}}{{/if}}</h1>
            {{#if custom_excerpt}}
            <p class="about-tagline">{{custom_excerpt}}</p>
            {{else}}
            <p class="about-tagline">{{@site.description}}</p>
            {{/if}}
        </div>
    </header>

    {{#get "authors" limit="1" include="count.posts" order="created_at asc"}}
        {{#foreach authors}}
        <aside class="about-profile">
            <div class="about-profile-inner">
                {{#if profile_image}}
                <img
                    src="{{img_url profile_image size='s'}}"
                    alt="{{name}}"
                    class="about-profile-avatar"
                    width="96"
                    height="96"
                    loading="eager"
                >
                {{/if}}
                <div class="about-profile-meta">
                    <h2 class="about-profile-name">{{name}}</h2>
                    {{#if bio}}
                    <p class="about-profile-bio">{{bio}}</p>
                    {{/if}}
                    <div class="about-profile-links">
                        {{#if website}}
                        <a href="{{website}}" target="_blank" rel="noopener noreferrer" class="about-profile-link">Website</a>
                        {{/if}}
                        {{#if twitter}}
                        <a href="https://twitter.com/{{twitter}}" target="_blank" rel="noopener noreferrer" class="about-profile-link">X / Twitter</a>
                        {{/if}}
                        {{#if facebook}}
                        <a href="https://facebook.com/{{facebook}}" target="_blank" rel="noopener noreferrer" class="about-profile-link">Facebook</a>
                        {{/if}}
                    </div>
                </div>
            </div>
        </aside>
        {{/foreach}}
    {{/get}}

    {{#if feature_image}}
    <figure class="about-feature-image">
        <img
            src="{{img_url feature_image size='xl'}}"
            srcset="{{img_url feature_image size='m'}} 600w, {{img_url feature_image size='l'}} 1000w, {{img_url feature_image size='xl'}} 2000w"
            sizes="(max-width: 1000px) 100vw, 1000px"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            loading="lazy"
        >
    </figure>
    {{/if}}

    <div class="about-body-wrapper">
        <section class="post-content gh-content about-content">
            {{content}}
        </section>
    </div>

    <div class="about-cta">
        <h3 class="about-cta-title">Join the conversation</h3>
        <p class="about-cta-text">Get new essays from {{@site.title}} delivered to your inbox.</p>
        <a href="#/portal/signup" class="btn btn-primary" data-portal="signup">Subscribe — it&#x27;s free</a>
    </div>

</article>
{{/page}}
