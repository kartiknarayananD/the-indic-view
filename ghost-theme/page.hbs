{{!< default}}

{{#page}}
<article class="page-full">

    {{#if @page.show_title_and_feature_image}}
    <header class="page-header">
        <div class="page-header-inner">
            {{#if primary_tag}}
            <div class="post-tags">
                <a href="{{primary_tag.url}}" class="post-card-tag tag-{{primary_tag.slug}}">{{primary_tag.name}}</a>
            </div>
            {{/if}}
            <h1 class="post-title page-title">{{title}}</h1>
            {{#if custom_excerpt}}
            <p class="post-excerpt">{{custom_excerpt}}</p>
            {{/if}}
        </div>
    </header>

    {{#if feature_image}}
    <figure class="post-feature-image page-feature-image">
        <img
            src="{{img_url feature_image size='xl'}}"
            srcset="{{img_url feature_image size='m'}} 600w, {{img_url feature_image size='l'}} 1000w, {{img_url feature_image size='xl'}} 2000w"
            sizes="(max-width: 1200px) 100vw, 1200px"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            loading="eager"
        >
        {{#if feature_image_caption}}
        <figcaption class="post-feature-image-caption">{{feature_image_caption}}</figcaption>
        {{/if}}
    </figure>
    {{/if}}
    {{/if}}

    <div class="post-body-wrapper page-body-wrapper">
        <section class="post-content gh-content page-content">
            {{content}}
        </section>
    </div>

</article>
{{/page}}
